# Registry configuration only. Credentials live in the user-level ~/.npmrc,
# which npm merges at runtime and git never sees.
#
# Without the scope line below, `npm install` looks for @unerp/* on the public
# registry, gets a 404, and the repository is uninstallable — which is what it
# was.
@unerp:registry=http://localhost:4873/
registry=https://registry.npmjs.org/
